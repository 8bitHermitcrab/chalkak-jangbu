# ── AI 인식 ───────────────────────────────────────────
# Claude API 키를 넣으면 Claude 비전 모델로 사진을 읽습니다 (손글씨·구겨진 명세서도 잘 읽음).
# 비워 두면 Tesseract OCR(한국어) + 규칙 파서로 동작합니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# auto | claude | tesseract
EXTRACTOR=auto

# ── 우리 가게 정보 ─────────────────────────────────────
# 거래명세서의 '공급받는자'(우리 가게)를 거래처로 잘못 잡지 않도록 알려 줍니다.
OWN_BUSINESS_NAME=
OWN_BUSINESS_NO=

# ── 기타 ──────────────────────────────────────────────
POSTGRES_PASSWORD=chalkak
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
